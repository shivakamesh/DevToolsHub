<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>true</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="Bogus.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Newtonsoft.Json.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Markdig.wasm" />
    <BlazorWebAssemblyLazyLoad Include="YamlDotNet.wasm" />
    <BlazorWebAssemblyLazyLoad Include="QRCoder.wasm" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.31" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
