@inherits LayoutComponentBase

<div class="bg-orbs" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
</div>

<header class="topbar glass">
    <button class="menu-btn" aria-label="Toggle menu" @onclick="() => menuOpen = !menuOpen">☰</button>
    <a class="brand" href="">
        <img class="logo" src="logo.svg" alt="" />
        <span>DevTools<span class="gradient-text">Hub</span></span>
    </a>
    <span class="tagline">Free · Fast · 100% in your browser</span>
    <button class="search-btn" title="Search tools (Ctrl+K)" @onclick="() => palette.Open()">🔍 <span>Search tools</span> <kbd>Ctrl K</kbd></button>
    <ThemeToggle />
</header>

<CommandPalette @ref="palette" />

<div class="shell">
    <nav class="sidebar glass @(menuOpen ? "open" : "")" @onclick="() => menuOpen = false">
        <NavLink href="" Match="NavLinkMatch.All"><span class="nav-icon">⌂</span> Home</NavLink>
        @foreach (var group in ToolCatalog.ByCategory)
        {
            <div class="nav-group">@group.Key</div>
            @foreach (var tool in group)
            {
                <NavLink href="@tool.Href"><span class="nav-icon">@tool.Icon</span> @tool.Name</NavLink>
            }
        }
    </nav>
    <main class="content">
        <div class="page-enter">
            @Body
        </div>
    </main>
</div>

<footer class="footer">
    &copy; @DateTime.UtcNow.Year DevToolsHub · Built with Blazor · No data leaves your browser 🔒
</footer>

@code {
    private bool menuOpen;
    private CommandPalette palette = default!;
}
