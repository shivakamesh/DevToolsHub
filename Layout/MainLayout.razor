@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing

<div class="bg-orbs" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
</div>

<header class="topbar glass">
    <button class="menu-btn @(menuOpen ? "on" : "")" aria-label="Toggle menu" aria-expanded="@menuOpen" @onclick="() => menuOpen = !menuOpen">
        <svg class="burger-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            @if (menuOpen)
            {
                <line x1="6" y1="6" x2="18" y2="18" />
                <line x1="18" y1="6" x2="6" y2="18" />
            }
            else
            {
                <line x1="4" y1="7" x2="20" y2="7" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <line x1="4" y1="17" x2="20" y2="17" />
            }
        </svg>
    </button>
    <a class="brand" href="/">
        <img class="logo" src="logo.svg" alt="" />
        <span>DevTools<span class="gradient-text">Hub</span></span>
    </a>
    <span class="tagline">Free · Fast · 100% in your browser</span>
    <button class="search-btn" title="Search tools (Ctrl+K)" @onclick="() => palette.Open()">🔍 <span>Search tools</span> <kbd>Ctrl K</kbd></button>
    <ThemeToggle />
</header>

<CommandPalette @ref="palette" />

<div class="shell @(collapsed ? "rail" : "")">
    <div class="nav-backdrop @(menuOpen ? "show" : "")" aria-hidden="true" @onclick="() => menuOpen = false"></div>
    <nav class="sidebar glass @(menuOpen ? "open" : "") @(collapsed ? "collapsed" : "")">
        <div class="side-head">
            @if (!collapsed)
            {
                <div class="side-filter-wrap">
                    <span class="side-filter-ico" aria-hidden="true">⌕</span>
                    <input class="side-filter" placeholder="Filter tools…" @bind="filter" @bind:event="oninput" aria-label="Filter tools" />
                    @if (!string.IsNullOrEmpty(filter))
                    {
                        <button class="side-filter-clear" title="Clear filter" aria-label="Clear filter" @onclick='() => filter = ""'>✕</button>
                    }
                </div>
            }
            <button class="collapse-btn" title="@(collapsed ? "Expand sidebar" : "Collapse sidebar")"
                    aria-label="Toggle sidebar" @onclick="ToggleCollapsed">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="3" />
                    <line x1="9" y1="4" x2="9" y2="20" />
                    <polyline class="collapse-chev" points="15 10 13 12 15 14" />
                </svg>
            </button>
        </div>
        <NavLink href="/" Match="NavLinkMatch.All" title="Home"><span class="nav-icon">⌂</span><span class="nav-label">Home</span></NavLink>
        @if (string.IsNullOrWhiteSpace(filter))
        {
            var favs = Resolve(Prefs.Favorites);
            var recent = Resolve(Prefs.Recent.Except(Prefs.Favorites)).Take(4).ToList();
            if (favs.Count > 0)
            {
                <div class="side-section">★ Favorites</div>
                @foreach (var tool in favs)
                {
                    <NavLink href="@tool.Href" title="@tool.Name"><span class="nav-icon">@tool.Icon</span><span class="nav-label">@tool.Name</span></NavLink>
                }
            }
            if (recent.Count > 0)
            {
                <div class="side-section">Recent</div>
                @foreach (var tool in recent)
                {
                    <NavLink href="@tool.Href" title="@tool.Name"><span class="nav-icon">@tool.Icon</span><span class="nav-label">@tool.Name</span></NavLink>
                }
            }
        }
        @foreach (var group in ToolCatalog.ByCategory)
        {
            var tools = group.Where(Matches).ToList();
            if (tools.Count == 0) continue;
            var isOpen = collapsed || !string.IsNullOrWhiteSpace(filter) || openGroup == group.Key;
            <button class="nav-group cat-@group.Key.ToLowerInvariant()" @onclick="() => ToggleGroup(group.Key)" aria-expanded="@isOpen" title="@group.Key">
                <span class="chev @(isOpen ? "open" : "")">▸</span>
                                <span class="dot"></span>
                <span class="nav-label">@group.Key</span>
                <span class="count">@tools.Count</span>
            </button>
            @if (isOpen)
            {
                @foreach (var tool in tools)
                {
                    <NavLink href="@tool.Href" title="@tool.Name"><span class="nav-icon">@tool.Icon</span><span class="nav-label">@tool.Name</span></NavLink>
                }
            }
        }
    </nav>
    <main class="content">
        <div class="page-enter">
            @Body
        </div>
    </main>
</div>

<footer class="footer">
    <nav class="footer-links">
        <a href="about">About</a>
        <a href="privacy">Privacy</a>
        <a href="contact">Contact</a>
    </nav>
    <div>&copy; @DateTime.UtcNow.Year It's All Dev Tools · No data leaves your browser 🔒</div>
</footer>

@code {
    private bool menuOpen;
    private bool collapsed;
    private string filter = "";
    private string? openGroup;
    private bool restoreScroll;
    private CommandPalette palette = default!;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private UserPrefs Prefs { get; set; } = default!;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Prefs.Changed += OnPrefsChanged;
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    private static List<ToolInfo> Resolve(IEnumerable<string> hrefs) =>
        hrefs.Select(ToolCatalog.Find).OfType<ToolInfo>().ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoreScroll)
        {
            restoreScroll = false;
            try { await JS.InvokeVoidAsync("devTools.restoreSidebarScroll"); } catch (JSException) { }
        }
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("devTools.trackSidebarScroll"); } catch (JSException) { }
        await Prefs.EnsureLoadedAsync();
        try
        {
            collapsed = await JS.InvokeAsync<string?>("localStorage.getItem", "sidebar.collapsed") == "1";
            openGroup = await JS.InvokeAsync<string?>("localStorage.getItem", "sidebar.openGroup");
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private bool Matches(ToolInfo t) =>
        string.IsNullOrWhiteSpace(filter) || t.Name.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase);

    private async Task ToggleCollapsed()
    {
        collapsed = !collapsed;
        await JS.InvokeVoidAsync("localStorage.setItem", "sidebar.collapsed", collapsed ? "1" : "0");
    }

    private async Task ToggleGroup(string key)
    {
        if (collapsed) { await ToggleCollapsed(); return; }
        openGroup = openGroup == key ? null : key;
        await JS.InvokeVoidAsync("localStorage.setItem", "sidebar.openGroup", openGroup ?? "");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        restoreScroll = true;
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Prefs.Changed -= OnPrefsChanged;
    }
}
