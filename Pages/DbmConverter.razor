@page "/dbm-converter"

<ToolPage Title="dBm to Watts & Volts Converter" Description="Convert between dBm, dBW, watts, milliwatts, volts RMS, dBµV and dBmV for 50, 75 or 600 Ω systems.">
    <div class="toolbar">
        <label>Value <input type="number" step="any" @bind="value" @bind:event="oninput" @bind:after="Calculate" /></label>
        <label>Unit
            <select @bind="unit" @bind:after="Calculate">
                <option value="dBm">dBm</option>
                <option value="dBW">dBW</option>
                <option value="W">W</option>
                <option value="mW">mW</option>
                <option value="uW">µW</option>
                <option value="V">V (RMS)</option>
                <option value="mV">mV (RMS)</option>
                <option value="dBuV">dBµV</option>
                <option value="dBmV">dBmV</option>
            </select>
        </label>
        <label>Impedance (Ω)
            <select @bind="impedance" @bind:after="Calculate">
                <option value="50">50</option>
                <option value="75">75</option>
                <option value="600">600</option>
            </select>
        </label>
    </div>

    @if (error is not null)
    {
        <div class="alert error">@error</div>
    }
    else
    {
        var dbm = 10 * Math.Log10(watts * 1000);
        var vrms = Math.Sqrt(watts * impedance);
        <table class="table">
            <tbody>
                <tr><th>dBm</th><td><strong><code>@Eng.N(dbm, "F2") dBm</code></strong></td></tr>
                <tr><th>dBW</th><td><code>@Eng.N(dbm - 30, "F2") dBW</code></td></tr>
                <tr><th>Power</th><td><strong><code>@Eng.Si(watts, "W")</code></strong></td></tr>
                <tr><th>Voltage (RMS)</th><td><code>@Eng.Si(vrms, "V")</code></td></tr>
                <tr><th>Voltage (peak / peak-to-peak)</th><td><code>@Eng.Si(vrms * Math.Sqrt(2), "V")</code> / <code>@Eng.Si(vrms * 2 * Math.Sqrt(2), "V")</code></td></tr>
                <tr><th>dBµV</th><td><code>@Eng.N(20 * Math.Log10(vrms * 1e6), "F2") dBµV</code></td></tr>
                <tr><th>dBmV</th><td><code>@Eng.N(20 * Math.Log10(vrms * 1e3), "F2") dBmV</code></td></tr>
            </tbody>
        </table>
        <p class="lead">dBm = 10 × log₁₀(P / 1 mW). V = √(P × R). 0 dBm = 1 mW = @Eng.Si(Math.Sqrt(0.001 * impedance), "V") RMS into @impedance Ω. Every +3 dB doubles power; +10 dB is 10× power.</p>
    }

    <h3>Quick reference (@impedance Ω)</h3>
    <table class="table">
        <thead><tr><th>dBm</th><th>Power</th><th>V RMS</th></tr></thead>
        <tbody>
            @foreach (var d in new[] { -30, -20, -10, 0, 10, 20, 30, 40, 50, 60 })
            {
                var w = Math.Pow(10, d / 10.0) / 1000;
                <tr><td>@d</td><td>@Eng.Si(w, "W")</td><td>@Eng.Si(Math.Sqrt(w * impedance), "V")</td></tr>
            }
        </tbody>
    </table>
</ToolPage>

@code {
    private double? value = 20;
    private string unit = "dBm";
    private int impedance = 50;
    private double watts;
    private string? error;

    protected override void OnInitialized() => Calculate();

    private void Calculate()
    {
        error = null;
        if (value is null) { error = "Enter a value."; return; }
        var v = value.Value;
        double FromVolts(double volts) => volts * volts / impedance;
        watts = unit switch
        {
            "dBm" => Math.Pow(10, v / 10) / 1000,
            "dBW" => Math.Pow(10, v / 10),
            "W" => v,
            "mW" => v / 1e3,
            "uW" => v / 1e6,
            "V" => FromVolts(v),
            "mV" => FromVolts(v / 1e3),
            "dBuV" => FromVolts(Math.Pow(10, v / 20) / 1e6),
            "dBmV" => FromVolts(Math.Pow(10, v / 20) / 1e3),
            _ => 0,
        };
        if (watts <= 0 || double.IsInfinity(watts)) error = "Power must be greater than zero.";
    }
}
