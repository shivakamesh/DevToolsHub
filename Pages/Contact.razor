@page "/contact"

<PageTitle>Contact | It's All Dev Tools</PageTitle>
<HeadContent>
    <meta name="description" content="Contact It's All Dev Tools with feedback, tool suggestions or bug reports." />
    <link rel="canonical" href="https://www.itsalldevtools.com/contact" />
</HeadContent>

<article class="legal glass">
    <h1>Contact</h1>
    <p>Have feedback, a tool suggestion, or found a bug? Get in touch:</p>
    <ul>
        <li>📧 Email: <a href="mailto:@Email">@Email</a></li>
    </ul>
    <p>We read every message and typically reply within a few days.</p>
    <p class="muted">Please do not send passwords, tokens or other secrets by email.</p>
</article>

@code {
    private const string Email = "contact@itsalldevtools.com";
}
