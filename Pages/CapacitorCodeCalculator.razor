@page "/capacitor-code-calculator"

<ToolPage Title="Capacitor Code Calculator (104, 103, 472 to pF/nF/µF)" Description="Decode ceramic, film and tantalum capacitor codes such as 104, 472J or 4n7 into pF, nF and µF, or find the code for a capacitance.">
    <h3>Decode a marking</h3>
    <div class="toolbar">
        <label>Capacitor code <input @bind="code" @bind:event="oninput" @bind:after="Decode" placeholder="e.g. 104K, 4n7, 2u2" /></label>
    </div>
    @if (decodeError is not null)
    {
        <div class="alert error">@decodeError</div>
    }
    else if (farads is not null)
    {
        <table class="table">
            <tbody>
                <tr><th>Capacitance</th><td><strong><code>@Eng.Si(farads.Value, "F")</code></strong></td></tr>
                <tr><th>pF / nF / µF</th><td><code>@Eng.N(farads.Value * 1e12, "G6") pF</code> · <code>@Eng.N(farads.Value * 1e9, "G6") nF</code> · <code>@Eng.N(farads.Value * 1e6, "G6") µF</code></td></tr>
                @if (tolerance is not null)
                {
                    <tr><th>Tolerance</th><td>@tolerance</td></tr>
                }
                <tr><th>Coding system</th><td>@system</td></tr>
            </tbody>
        </table>
    }

    <h3>Find the code for a value</h3>
    <div class="toolbar">
        <label>Capacitance <input @bind="valueText" @bind:event="oninput" placeholder="e.g. 100n, 4.7u, 22p" /></label>
    </div>
    @if (Eng.TryParseSi(valueText, out var f) && f > 0)
    {
        <table class="table">
            <tbody>
                <tr><th>3-digit code</th><td><code>@ToCode(f * 1e12)</code></td></tr>
                <tr><th>Value</th><td>@Eng.Si(f, "F") = @Eng.N(f * 1e12, "G6") pF</td></tr>
            </tbody>
        </table>
    }

    <h3>Tolerance letters</h3>
    <table class="table">
        <thead><tr><th>Letter</th><th>Tolerance</th></tr></thead>
        <tbody>
            @foreach (var t in Tolerances)
            {
                <tr><td><code>@t.Key</code></td><td>@t.Value</td></tr>
            }
        </tbody>
    </table>
</ToolPage>

@code {
    private string code = "104K", valueText = "4.7n";
    private double? farads;
    private string? tolerance, system, decodeError;

    private static readonly Dictionary<char, string> Tolerances = new()
    {
        ['B'] = "±0.1 pF", ['C'] = "±0.25 pF", ['D'] = "±0.5 pF (or ±0.5 %)", ['F'] = "±1 pF (or ±1 %)", ['G'] = "±2 %",
        ['J'] = "±5 %", ['K'] = "±10 %", ['M'] = "±20 %", ['Z'] = "+80 % / −20 %",
    };

    protected override void OnInitialized() => Decode();

    private void Decode()
    {
        farads = null;
        tolerance = null;
        decodeError = null;
        var s = (code ?? "").Trim().Replace(" ", "");
        if (s.Length == 0) return;

        if (s.Length > 1 && Tolerances.ContainsKey(char.ToUpperInvariant(s[^1])) && char.IsDigit(s[^2]))
        {
            tolerance = Tolerances[char.ToUpperInvariant(s[^1])];
            s = s[..^1];
        }

        if (s.Length == 3 && s.All(char.IsDigit))
        {
            var digits = int.Parse(s[..2]);
            var m = s[2] - '0';
            if (m is 6 or 7) { decodeError = "A multiplier digit of 6 or 7 is not used in capacitor codes."; return; }
            var mult = m switch { 8 => 0.01, 9 => 0.1, _ => Math.Pow(10, m) };
            farads = digits * mult * 1e-12;
            system = "EIA 3-digit code (two significant digits × 10ⁿ pF)";
        }
        else if (s.Length <= 2 && s.All(char.IsDigit))
        {
            farads = int.Parse(s) * 1e-12;
            system = "Value printed directly in pF";
        }
        else if (s.Contains('.') && double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var uf))
        {
            farads = uf * 1e-6;
            system = "Decimal value, read as µF (common on film capacitors)";
        }
        else if (Eng.TryParseSi(s, out var v) && s.Any(char.IsLetter))
        {
            farads = s.Contains('R') || s.Contains('r') ? v * 1e-6 : v;
            system = s.Contains('R') || s.Contains('r') ? "R notation in µF (R = decimal point)" : "IEC 60062 letter code (p, n, µ replace the decimal point)";
        }
        else
        {
            decodeError = "Unrecognised code. Try formats like 104, 472J, 4n7, 2u2 or 0.47.";
        }
    }

    private static string ToCode(double pf)
    {
        if (pf < 10)
        {
            return pf < 1
                ? $"{Eng.N(pf * 100, "00")}8 (≈ {Eng.N(Math.Round(pf * 100) / 100, "G3")} pF)"
                : $"{Eng.N(pf, "G2").Replace(".", "R")} (or {Eng.N(pf * 10, "0")}9)";
        }
        var exp = (int)Math.Floor(Math.Log10(pf)) - 1;
        var digits = (int)Math.Round(pf / Math.Pow(10, exp));
        if (digits >= 100) { digits /= 10; exp++; }
        var exact = digits * Math.Pow(10, exp);
        var note = Math.Abs(exact - pf) / pf > 0.001 ? $" (≈ {Eng.N(exact, "G4")} pF)" : "";
        return exp > 6 ? "out of range" : $"{digits:00}{exp}{note}";
    }
}
