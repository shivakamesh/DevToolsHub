@page "/what-is-my-ip"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http

<ToolPage Title="What Is My IP Address" Description="See your public IPv4 and IPv6 address, location and ISP.">
    <div class="stats-grid">
        <div class="stat glass">
            <span class="muted">IPv4</span>
            <strong class="break">@(ipv4 ?? (loading ? "Detecting…" : "Not available"))</strong>
            @if (ipv4 is not null) { <CopyButton Text="@ipv4" /> }
        </div>
        <div class="stat glass">
            <span class="muted">IPv6</span>
            <strong class="break">@(ipv6 ?? (loading ? "Detecting…" : "Not available"))</strong>
            @if (ipv6 is not null) { <CopyButton Text="@ipv6" /> }
        </div>
    </div>

    @if (info is not null)
    {
        <table class="table">
            <tbody>
                <tr><th>Location</th><td>@string.Join(", ", new[] { info.City, info.Region, info.CountryName }.Where(s => !string.IsNullOrWhiteSpace(s)))</td></tr>
                <tr><th>Postal code</th><td>@info.Postal</td></tr>
                <tr><th>Coordinates</th><td>@info.Latitude, @info.Longitude</td></tr>
                <tr><th>Time zone</th><td>@info.Timezone (UTC@(info.UtcOffset))</td></tr>
                <tr><th>ISP / organization</th><td>@info.Org</td></tr>
                <tr><th>ASN</th><td>@info.Asn</td></tr>
            </tbody>
        </table>
        <p class="muted">Location is approximate and based on public IP databases.</p>
    }

    @if (error is not null)
    {
        <div class="alert error">@error</div>
    }

    <div class="toolbar">
        <button class="btn secondary" disabled="@loading" @onclick="LoadAsync">↻ Refresh</button>
    </div>
    <p class="muted">Your IP is looked up with ipify.org and ipapi.co directly from your browser. Nothing is stored by this site.</p>
</ToolPage>

@code {
    private sealed class IpResult
    {
        [JsonPropertyName("ip")] public string? Ip { get; set; }
    }

    private sealed class GeoInfo
    {
        [JsonPropertyName("city")] public string? City { get; set; }
        [JsonPropertyName("region")] public string? Region { get; set; }
        [JsonPropertyName("country_name")] public string? CountryName { get; set; }
        [JsonPropertyName("postal")] public string? Postal { get; set; }
        [JsonPropertyName("latitude")] public double? Latitude { get; set; }
        [JsonPropertyName("longitude")] public double? Longitude { get; set; }
        [JsonPropertyName("timezone")] public string? Timezone { get; set; }
        [JsonPropertyName("utc_offset")] public string? UtcOffset { get; set; }
        [JsonPropertyName("org")] public string? Org { get; set; }
        [JsonPropertyName("asn")] public string? Asn { get; set; }
        [JsonPropertyName("error")] public bool Error { get; set; }
        [JsonPropertyName("reason")] public string? Reason { get; set; }
    }

    private string? ipv4;
    private string? ipv6;
    private GeoInfo? info;
    private bool loading = true;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only look up the IP in the browser, never while pre-rendering.
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        StateHasChanged();

        var v4 = TryGetIpAsync("https://api.ipify.org?format=json");
        var v6 = TryGetIpAsync("https://api64.ipify.org?format=json");
        ipv4 = await v4;
        var any = await v6;
        ipv6 = any is not null && any.Contains(':') ? any : null;
        ipv4 ??= any is not null && !any.Contains(':') ? any : null;

        var lookup = ipv4 ?? ipv6;
        if (lookup is null)
        {
            error = "Could not detect your IP address. An ad blocker or privacy extension may be blocking the lookup.";
        }
        else
        {
            try
            {
                info = await Http.GetFromJsonAsync<GeoInfo>($"https://ipapi.co/{lookup}/json/");
                if (info?.Error == true)
                {
                    error = "Location lookup failed: " + info.Reason;
                    info = null;
                }
            }
            catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
            {
                info = null;
                error = "Location details are unavailable right now (the free lookup service may be rate-limited).";
            }
        }

        loading = false;
        StateHasChanged();
    }

    private async Task<string?> TryGetIpAsync(string url)
    {
        try
        {
            return (await Http.GetFromJsonAsync<IpResult>(url))?.Ip;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            return null;
        }
    }
}
