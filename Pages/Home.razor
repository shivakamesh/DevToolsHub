@page "/"
@implements IDisposable
@inject UserPrefs Prefs

<PageTitle>DevToolsHub - Free Online Developer Tools</PageTitle>

<section class="hero">
    <span class="pill">✨ @ToolCatalog.All.Count free tools · no sign-up</span>
    <h1 class="hero-title">Developer tools that <span class="gradient-text">respect your data</span></h1>
    <p class="lead">Everything runs locally in your browser. Nothing is uploaded, ever.</p>
    <input class="io search" placeholder="🔍  Search tools...  (tip: press Ctrl+K anywhere)" @bind="query" @bind:event="oninput" />
</section>

@if (string.IsNullOrWhiteSpace(query))
{
    var favorites = Resolve(Prefs.Favorites);
    var recent = Resolve(Prefs.Recent);
    if (favorites.Count > 0)
    {
        <h2 class="section-title">★ Favorites</h2>
        <div class="chip-row">
            @foreach (var t in favorites)
            {
                <a class="tool-chip glass" href="@t.Href"><span class="nav-icon">@t.Icon</span> @t.Name</a>
            }
        </div>
    }
    if (recent.Count > 0)
    {
        <h2 class="section-title">🕒 Recently used</h2>
        <div class="chip-row">
            @foreach (var t in recent)
            {
                <a class="tool-chip glass" href="@t.Href"><span class="nav-icon">@t.Icon</span> @t.Name</a>
            }
        </div>
    }
}

@foreach (var group in Filtered().GroupBy(t => t.Category).OrderBy(g => Array.IndexOf(ToolCatalog.Categories, g.Key)))
{
    <h2 class="section-title">@group.Key</h2>
    <div class="grid">
        @foreach (var t in group)
        {
            <a class="card glass" href="@t.Href">
                <span class="card-icon">@t.Icon</span>
                <h3>@t.Name</h3>
                <p>@t.Summary</p>
                <span class="card-arrow">→</span>
            </a>
        }
    </div>
}

@if (!Filtered().Any())
{
    <p class="lead">No tools match "@query".</p>
}

@code {
    private string query = "";

    private IEnumerable<ToolInfo> Filtered() =>
        string.IsNullOrWhiteSpace(query)
            ? ToolCatalog.All
            : ToolCatalog.All.Where(t => t.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                                      || t.Summary.Contains(query, StringComparison.OrdinalIgnoreCase));

    private static List<ToolInfo> Resolve(IEnumerable<string> hrefs) =>
        hrefs.Select(ToolCatalog.Find).OfType<ToolInfo>().ToList();

    protected override async Task OnInitializedAsync()
    {
        Prefs.Changed += OnPrefsChanged;
        await Prefs.EnsureLoadedAsync();
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Prefs.Changed -= OnPrefsChanged;
}
