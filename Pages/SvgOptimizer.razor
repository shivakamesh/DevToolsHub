@page "/svg-optimizer"
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@using System.Xml
@using System.Xml.Linq

<ToolPage Title="SVG Optimizer" Description="Minify SVG files: strip editor metadata, comments and empty groups, and round coordinates. Runs in your browser.">
    <textarea class="io" rows="10" placeholder="Paste SVG markup..." @bind="input" @bind:event="oninput"></textarea>

    <div class="toolbar">
        <label><input type="checkbox" @bind="removeComments" /> Remove comments</label>
        <label><input type="checkbox" @bind="removeMetadata" /> Remove metadata</label>
        <label><input type="checkbox" @bind="removeEditorData" /> Remove editor data (Inkscape, Illustrator, Sketch)</label>
        <label><input type="checkbox" @bind="removeEmpty" /> Remove empty groups</label>
        <label><input type="checkbox" @bind="roundNumbers" /> Round numbers to
            <input type="number" min="0" max="6" style="width: 4rem" @bind="precision" /> decimals</label>
        <label><input type="checkbox" @bind="minify" /> Minify</label>
        <button class="btn" @onclick="Optimize">Optimize</button>
        <CopyButton Text="@output" />
    </div>

    @if (error is not null)
    {
        <div class="alert error">@error</div>
    }
    else if (output.Length > 0)
    {
        var before = Encoding.UTF8.GetByteCount(input);
        var after = Encoding.UTF8.GetByteCount(output);
        <div class="alert ok">@before.ToString("N0") bytes → @after.ToString("N0") bytes (@((before == 0 ? 0 : 100.0 * (before - after) / before).ToString("0.#"))% smaller)</div>
        <div class="split">
            <div><strong>Original</strong><br /><img alt="Original SVG preview" style="max-width: 100%; max-height: 240px" src="@DataUri(input)" /></div>
            <div><strong>Optimized</strong><br /><img alt="Optimized SVG preview" style="max-width: 100%; max-height: 240px" src="@DataUri(output)" /></div>
        </div>
    }
    <textarea class="io" rows="10" readonly>@output</textarea>
</ToolPage>

@code {
    private static readonly HashSet<string> EditorNamespaces =
    [
        "http://www.inkscape.org/namespaces/inkscape",
        "http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd",
        "http://www.bohemiancoding.com/sketch/ns",
        "http://ns.adobe.com/AdobeIllustrator/10.0/",
        "http://ns.adobe.com/AdobeSVGViewerExtensions/3.0/",
        "http://ns.adobe.com/Extensibility/1.0/",
        "http://ns.adobe.com/Flows/1.0/",
        "http://ns.adobe.com/Graphs/1.0/",
        "http://ns.adobe.com/ImageReplacement/1.0/",
        "http://ns.adobe.com/SaveForWeb/1.0/",
        "http://ns.adobe.com/Variables/1.0/",
        "http://ns.adobe.com/GenericCustomNamespace/1.0/",
        "http://ns.adobe.com/XPath/1.0/",
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "http://purl.org/dc/elements/1.1/",
        "http://creativecommons.org/ns#",
    ];

    private static readonly HashSet<string> NumericAttributes =
    [
        "d", "points", "transform", "viewBox", "x", "y", "x1", "y1", "x2", "y2", "cx", "cy", "r", "rx", "ry",
        "width", "height", "stroke-width", "opacity", "fill-opacity", "stroke-opacity", "offset", "fx", "fy",
    ];

    private static readonly Regex Decimal = new(@"-?(?:\d+\.\d*|\.\d+)(?:[eE][-+]?\d+)?", RegexOptions.Compiled);

    private string input = ToolSamples.Svg;

    private string output = "";
    private string? error;
    private bool removeComments = true, removeMetadata = true, removeEditorData = true, removeEmpty = true, roundNumbers = true, minify = true;
    private int precision = 2;

    private void Optimize()
    {
        error = null;
        output = "";
        try
        {
            var doc = XDocument.Parse(input.Trim(), LoadOptions.None);
            doc.Declaration = null;
            doc.DocumentType?.Remove();
            doc.DescendantNodes().OfType<XProcessingInstruction>().ToList().Remove();
            if (removeComments) doc.DescendantNodes().OfType<XComment>().ToList().Remove();
            if (removeMetadata) doc.Descendants().Where(e => e.Name.LocalName == "metadata").ToList().Remove();

            if (removeEditorData)
            {
                doc.Descendants().Where(e => EditorNamespaces.Contains(e.Name.NamespaceName)).ToList().Remove();
                doc.Descendants().Attributes()
                    .Where(a => EditorNamespaces.Contains(a.Name.NamespaceName) || (a.IsNamespaceDeclaration && EditorNamespaces.Contains(a.Value)))
                    .ToList().Remove();
            }

            if (removeEmpty)
            {
                List<XElement> empty;
                while ((empty = doc.Descendants()
                           .Where(e => e.Name.LocalName is "g" or "defs" && !e.HasElements && string.IsNullOrWhiteSpace(e.Value))
                           .ToList()).Count > 0)
                    empty.Remove();
            }

            if (roundNumbers)
            {
                var p = Math.Clamp(precision, 0, 6);
                foreach (var a in doc.Descendants().Attributes().Where(a => !a.IsNamespaceDeclaration && NumericAttributes.Contains(a.Name.LocalName)))
                {
                    var compact = a.Name.LocalName is "d" or "points";
                    a.Value = Decimal.Replace(a.Value, m => Round(m.Value, p, compact));
                }
            }

            doc.Root?.Attribute("version")?.Remove();
            doc.Root?.Attribute(XNamespace.Xml + "space")?.Remove();

            output = doc.Root is null ? "" : doc.Root.ToString(minify ? SaveOptions.DisableFormatting : SaveOptions.None);
        }
        catch (XmlException ex)
        {
            error = $"Invalid SVG/XML: {ex.Message}";
        }
    }

    private static string Round(string value, int precision, bool compact)
    {
        if (!double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var d)) return value;
        var r = Math.Round(d, precision);
        if (r == 0) r = 0;
        var s = r.ToString("0.######", CultureInfo.InvariantCulture);
        if (compact)
        {
            if (s.StartsWith("0.")) s = s[1..];
            else if (s.StartsWith("-0.")) s = "-" + s[2..];
        }
        return s;
    }

    private static string DataUri(string svg) =>
        "data:image/svg+xml;base64," + System.Convert.ToBase64String(Encoding.UTF8.GetBytes(svg));
}
