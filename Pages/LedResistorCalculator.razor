@page "/led-resistor-calculator"
@using System.Globalization

<ToolPage Title="LED Resistor Calculator" Description="Calculate the series resistor value and power rating for one or more LEDs.">
    <div class="toolbar">
        <label>Supply voltage (V) <input type="number" min="0" step="any" @bind="vs" @bind:event="oninput" /></label>
        <label>LED forward voltage (V) <input type="number" min="0" step="any" @bind="vf" @bind:event="oninput" /></label>
        <label>LED current (mA) <input type="number" min="0" step="any" @bind="ma" @bind:event="oninput" /></label>
        <label>LEDs in series <input type="number" min="1" step="1" @bind="count" @bind:event="oninput" /></label>
    </div>

    @{
        var vr = vs - vf * count;
    }
    @if (vs <= 0 || vf <= 0 || ma <= 0 || count < 1)
    {
        <div class="alert error">Enter positive values for voltage, forward voltage, current and LED count.</div>
    }
    else if (vr <= 0)
    {
        <div class="alert error">Supply voltage must be higher than the total LED forward voltage (@Fmt(vf * count) V).</div>
    }
    else
    {
        var i = ma / 1000;
        var r = vr / i;
        var e24 = NextE24(r);
        var actualMa = vr / e24 * 1000;
        var pr = vr * vr / e24;

        <table class="table">
            <tbody>
                <tr><th>Exact resistance</th><td><code>@Fmt(r) Ω</code></td></tr>
                <tr><th>Nearest E24 (higher)</th><td><strong><code>@Fmt(e24) Ω</code></strong></td></tr>
                <tr><th>Actual LED current</th><td><code>@Fmt(actualMa) mA</code></td></tr>
                <tr><th>Resistor power</th><td><code>@Fmt(pr * 1000) mW</code> (use ≥ @Rating(pr))</td></tr>
                <tr><th>Total power</th><td><code>@Fmt(vs * actualMa) mW</code></td></tr>
                <tr><th>Efficiency</th><td><code>@Fmt(vf * count / vs * 100) %</code></td></tr>
            </tbody>
        </table>
        <p class="lead">R = (V<sub>s</sub> − n × V<sub>f</sub>) / I. Typical V<sub>f</sub>: red 2.0 V, yellow/green 2.1 V, blue/white 3.2 V.</p>
    }
</ToolPage>

@code {
    private double vs = 12;
    private double vf = 2.0;
    private double ma = 20;
    private int count = 1;

    private static readonly double[] E24 = [1.0, 1.1, 1.2, 1.3, 1.5, 1.6, 1.8, 2.0, 2.2, 2.4, 2.7, 3.0, 3.3, 3.6, 3.9, 4.3, 4.7, 5.1, 5.6, 6.2, 6.8, 7.5, 8.2, 9.1];

    private static double NextE24(double r)
    {
        var decade = Math.Pow(10, Math.Floor(Math.Log10(r)));
        foreach (var v in E24)
        {
            var c = Math.Round(v * decade, 6);
            if (c >= r - 1e-9) return c;
        }
        return 10 * decade;
    }

    private static string Rating(double w) => w switch
    {
        <= 0.125 / 2 => "1/8 W",
        <= 0.25 / 2 => "1/4 W",
        <= 0.5 / 2 => "1/2 W",
        <= 0.5 => "1 W",
        <= 1 => "2 W",
        _ => Fmt(Math.Ceiling(w * 2)) + " W",
    };

    private static string Fmt(double d) => d.ToString("#,0.##", CultureInfo.InvariantCulture);
}
