@page "/crypto-tools"
@inject IJSRuntime JS

<ToolPage Title="Bcrypt, AES & RSA Tools" Description="Hash and verify passwords with bcrypt, encrypt text with AES-256-GCM using a password, and generate RSA key pairs to encrypt and decrypt with RSA-OAEP. Everything runs in your browser.">
    <div class="toolbar">
        <button class="btn @(tab == "bcrypt" ? "" : "secondary")" @onclick='() => tab = "bcrypt"'>Bcrypt</button>
        <button class="btn @(tab == "aes" ? "" : "secondary")" @onclick='() => tab = "aes"'>AES</button>
        <button class="btn @(tab == "rsa" ? "" : "secondary")" @onclick='() => tab = "rsa"'>RSA</button>
    </div>
    @if (error is not null) { <div class="alert error">@error</div> }

    @if (tab == "bcrypt")
    {
        <h3>Hash a password</h3>
        <div class="toolbar">
            <input class="io" style="max-width:320px" placeholder="Password" @bind="bcryptInput" @bind:event="oninput" />
            <label>Cost <input type="number" min="4" max="14" @bind="cost" /></label>
            <button class="btn" @onclick="BcryptHash" disabled="@busy">Hash</button>
        </div>
        @if (bcryptHash.Length > 0)
        {
            <div class="toolbar"><code class="mono">@bcryptHash</code><CopyButton Text="@bcryptHash" /></div>
        }
        <h3>Verify</h3>
        <div class="toolbar">
            <input class="io" style="max-width:320px" placeholder="Password" @bind="verifyPassword" @bind:event="oninput" />
            <input class="io mono" placeholder="$2a$... hash" @bind="verifyHash" @bind:event="oninput" />
            <button class="btn" @onclick="BcryptVerify" disabled="@busy">Verify</button>
        </div>
        @if (verifyResult is not null) { <p class="@(verifyResult == true ? "game-ok" : "game-bad")">@(verifyResult == true ? "✓ Password matches the hash" : "✗ Password does not match")</p> }
        <p class="muted">Higher costs are slower in WebAssembly; 10–12 is typical for production.</p>
    }
    else if (tab == "aes")
    {
        <div class="toolbar">
            <input class="io" style="max-width:320px" type="password" placeholder="Password" @bind="aesPassword" @bind:event="oninput" />
            <label>PBKDF2 iterations <input type="number" min="1000" step="1000" @bind="iterations" /></label>
            <button class="btn" @onclick="AesEncrypt">Encrypt</button>
            <button class="btn secondary" @onclick="AesDecrypt">Decrypt</button>
            <CopyButton Text="@aesOutput" />
        </div>
        <textarea class="io" rows="6" placeholder="Plain text, or Base64 ciphertext to decrypt" @bind="aesInput" @bind:event="oninput"></textarea>
        <textarea class="io mono" rows="6" readonly>@aesOutput</textarea>
        <p class="muted">AES-256-GCM with a key derived via PBKDF2-SHA256. Output is Base64 of salt (16 bytes) + IV (12 bytes) + ciphertext and tag.</p>
    }
    else
    {
        <div class="toolbar">
            <label>Key size
                <select @bind="rsaBits">
                    <option value="2048">2048</option>
                    <option value="3072">3072</option>
                    <option value="4096">4096</option>
                </select>
            </label>
            <button class="btn" @onclick="RsaGenerate" disabled="@busy">Generate key pair</button>
        </div>
        <div class="golf-cols">
            <div>
                <div class="toolbar"><b>Public key (SPKI PEM)</b><CopyButton Text="@publicKey" /></div>
                <textarea class="io mono" rows="8" @bind="publicKey"></textarea>
            </div>
            <div>
                <div class="toolbar"><b>Private key (PKCS#8 PEM)</b><CopyButton Text="@privateKey" /></div>
                <textarea class="io mono" rows="8" @bind="privateKey"></textarea>
            </div>
        </div>
        <div class="toolbar">
            <button class="btn" @onclick="RsaEncrypt">Encrypt with public key</button>
            <button class="btn secondary" @onclick="RsaDecrypt">Decrypt with private key</button>
            <CopyButton Text="@rsaOutput" />
        </div>
        <textarea class="io" rows="4" placeholder="Plain text, or Base64 ciphertext to decrypt" @bind="rsaInput" @bind:event="oninput"></textarea>
        <textarea class="io mono" rows="4" readonly>@rsaOutput</textarea>
        <p class="muted">RSA-OAEP with SHA-256. A 2048-bit key can encrypt up to 190 bytes of text.</p>
    }
</ToolPage>

@code {
    private string tab = "bcrypt";
    private string? error;
    private bool busy;

    private string bcryptInput = "", bcryptHash = "", verifyPassword = "", verifyHash = "";
    private int cost = 10;
    private bool? verifyResult;

    private string aesPassword = "", aesInput = "", aesOutput = "";
    private int iterations = 100000;

    private int rsaBits = 2048;
    private string publicKey = "", privateKey = "", rsaInput = "", rsaOutput = "";

    private async Task BcryptHash()
    {
        error = null;
        busy = true;
        await Task.Yield();
        try { bcryptHash = BCrypt.Net.BCrypt.HashPassword(bcryptInput, Math.Clamp(cost, 4, 14)); }
        catch (Exception e) { error = e.Message; }
        finally { busy = false; }
    }

    private async Task BcryptVerify()
    {
        error = null;
        busy = true;
        await Task.Yield();
        try { verifyResult = BCrypt.Net.BCrypt.Verify(verifyPassword, verifyHash.Trim()); }
        catch (Exception e) { verifyResult = null; error = "Invalid bcrypt hash: " + e.Message; }
        finally { busy = false; }
    }

    private Task AesEncrypt() => RunJs(async () => aesOutput = await JS.InvokeAsync<string>("devMore.aesEncrypt", aesPassword, aesInput, iterations));
    private Task AesDecrypt() => RunJs(async () => aesOutput = await JS.InvokeAsync<string>("devMore.aesDecrypt", aesPassword, aesInput, iterations));

    private Task RsaGenerate() => RunJs(async () =>
    {
        var keys = await JS.InvokeAsync<RsaKeys>("devMore.rsaGenerate", rsaBits);
        publicKey = keys.PublicKey;
        privateKey = keys.PrivateKey;
    });

    private Task RsaEncrypt() => RunJs(async () => rsaOutput = await JS.InvokeAsync<string>("devMore.rsaEncrypt", publicKey, rsaInput));
    private Task RsaDecrypt() => RunJs(async () => rsaOutput = await JS.InvokeAsync<string>("devMore.rsaDecrypt", privateKey, rsaInput));

    private async Task RunJs(Func<Task> action)
    {
        error = null;
        busy = true;
        try { await action(); }
        catch (JSException e) { error = e.Message.Split('\n')[0]; }
        finally { busy = false; }
    }

    private sealed record RsaKeys(string PublicKey, string PrivateKey);
}
