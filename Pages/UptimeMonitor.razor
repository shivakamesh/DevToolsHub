@page "/uptime-monitor"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Diagnostics
@inject HttpClient Http
@inject IJSRuntime JS

<ToolPage Title="Uptime &amp; SSL Expiry Monitor" Description="Check if a site is up and when its SSL certificate expires, from several regions.">
    <div class="toolbar">
        <label>URL <input class="small-input wide" placeholder="https://example.com" @bind="url" @bind:event="oninput" @onkeydown="OnKey" /></label>
        <button class="btn" disabled="@(running || regions.Count == 0)" @onclick="RunAsync">@(running ? "Checking…" : "Check")</button>
    </div>

    @if (error is not null)
    {
        <div class="alert error">@error</div>
    }

    @if (results.Count > 0)
    {
        <table class="table">
            <thead>
                <tr><th>Region</th><th>Status</th><th>HTTP</th><th>Response</th><th>SSL expires</th><th>Issuer</th></tr>
            </thead>
            <tbody>
                @foreach (var r in results)
                {
                    <tr>
                        <td>@r.Region</td>
                        <td>@(r.Pending ? "…" : r.Error is not null ? $"✗ {r.Error}" : r.Up ? "✓ Up" : "✗ Down")</td>
                        <td>@(r.StatusCode?.ToString() ?? "—")</td>
                        <td>@(r.ResponseTimeMs is null ? "—" : $"{r.ResponseTimeMs} ms")</td>
                        <td>@ExpiryText(r.CertExpires)</td>
                        <td>@(r.CertIssuer ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>Regions</h3>
    <p>
        Browsers can't read TLS certificates or check sites from other regions, so each region calls a check endpoint you host
        (for example an Azure Function or AWS Lambda in that region). The endpoint gets
        <code>GET {endpoint}?url={encoded url}</code> and must allow CORS. It returns JSON:
    </p>
    <pre class="io"><code>{ "up": true, "statusCode": 200, "responseTimeMs": 123,
  "certExpires": "2025-12-31T23:59:59Z", "certIssuer": "R11", "error": null }</code></pre>

    <table class="table">
        <thead><tr><th>Name</th><th>Endpoint</th><th></th></tr></thead>
        <tbody>
            @foreach (var region in regions)
            {
                <tr>
                    <td>@region.Name</td>
                    <td><code class="break">@region.Endpoint</code></td>
                    <td><button class="btn secondary" @onclick="() => RemoveRegionAsync(region)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="toolbar">
        <label>Name <input class="small-input" placeholder="West Europe" @bind="newName" /></label>
        <label>Endpoint <input class="small-input wide" placeholder="https://weu-check.example.com/api/check" @bind="newEndpoint" /></label>
        <button class="btn secondary" @onclick="AddRegionAsync">Add region</button>
    </div>
</ToolPage>

@code {
    private const string StorageKey = "uptime-regions";
    private const int WarnDays = 14;

    private string url = "";
    private string newName = "";
    private string newEndpoint = "";
    private string? error;
    private bool running;
    private List<RegionEndpoint> regions = [];
    private List<RegionResult> results = [];

    private sealed record RegionEndpoint(string Name, string Endpoint);

    private sealed class CheckResponse
    {
        public bool Up { get; set; }
        public int? StatusCode { get; set; }
        public int? ResponseTimeMs { get; set; }
        public DateTimeOffset? CertExpires { get; set; }
        public string? CertIssuer { get; set; }
        public string? Error { get; set; }
    }

    private sealed class RegionResult(string region)
    {
        public string Region { get; } = region;
        public bool Pending { get; set; } = true;
        public bool Up { get; set; }
        public int? StatusCode { get; set; }
        public long? ResponseTimeMs { get; set; }
        public DateTimeOffset? CertExpires { get; set; }
        public string? CertIssuer { get; set; }
        public string? Error { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrEmpty(json))
            {
                regions = JsonSerializer.Deserialize<List<RegionEndpoint>>(json) ?? [];
                StateHasChanged();
            }
        }
        catch (JsonException)
        {
            regions = [];
        }
    }

    private Task SaveRegionsAsync() =>
        JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(regions)).AsTask();

    private async Task AddRegionAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(newName) || !Uri.TryCreate(newEndpoint.Trim(), UriKind.Absolute, out var ep) || ep.Scheme is not ("http" or "https"))
        {
            error = "Enter a region name and a valid http(s) endpoint URL.";
            return;
        }
        regions.Add(new RegionEndpoint(newName.Trim(), ep.ToString()));
        newName = newEndpoint = "";
        await SaveRegionsAsync();
    }

    private async Task RemoveRegionAsync(RegionEndpoint region)
    {
        regions.Remove(region);
        await SaveRegionsAsync();
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !running && regions.Count > 0) await RunAsync();
    }

    private async Task RunAsync()
    {
        error = null;
        var target = url.Trim();
        if (!target.Contains("://")) target = "https://" + target;
        if (!Uri.TryCreate(target, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https"))
        {
            error = "Enter a valid http(s) URL.";
            return;
        }

        running = true;
        results = regions.Select(r => new RegionResult(r.Name)).ToList();
        StateHasChanged();

        await Task.WhenAll(regions.Select((r, i) => CheckAsync(r, uri, results[i])));
        running = false;
    }

    private async Task CheckAsync(RegionEndpoint region, Uri target, RegionResult result)
    {
        var sw = Stopwatch.StartNew();
        try
        {
            var sep = region.Endpoint.Contains('?') ? '&' : '?';
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var res = await Http.GetFromJsonAsync<CheckResponse>($"{region.Endpoint}{sep}url={Uri.EscapeDataString(target.ToString())}", cts.Token);
            if (res is null)
            {
                result.Error = "Empty response";
            }
            else
            {
                result.Up = res.Up;
                result.StatusCode = res.StatusCode;
                result.ResponseTimeMs = res.ResponseTimeMs ?? sw.ElapsedMilliseconds;
                result.CertExpires = res.CertExpires;
                result.CertIssuer = res.CertIssuer;
                result.Error = res.Error;
            }
        }
        catch (OperationCanceledException)
        {
            result.Error = "Timed out";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or NotSupportedException)
        {
            result.Error = "Check endpoint failed: " + ex.Message;
        }
        result.Pending = false;
        StateHasChanged();
    }

    private static string ExpiryText(DateTimeOffset? expires)
    {
        if (expires is null) return "—";
        var days = (int)Math.Floor((expires.Value - DateTimeOffset.UtcNow).TotalDays);
        var date = expires.Value.ToString("yyyy-MM-dd");
        return days < 0 ? $"⚠ Expired {date}" : days <= WarnDays ? $"⚠ {date} ({days} days)" : $"{date} ({days} days)";
    }
}
