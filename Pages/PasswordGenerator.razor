@page "/password-generator"
@using System.Security.Cryptography

<ToolPage Title="Password Generator" Description="Generate strong random passwords using a cryptographically secure generator.">
    <div class="toolbar">
        <label>Length <input type="number" min="4" max="128" @bind="length" /></label>
        <label>Count <input type="number" min="1" max="100" @bind="count" /></label>
        <label><input type="checkbox" @bind="lower" /> a-z</label>
        <label><input type="checkbox" @bind="upperCase" /> A-Z</label>
        <label><input type="checkbox" @bind="digits" /> 0-9</label>
        <label><input type="checkbox" @bind="symbols" /> Symbols</label>
        <label><input type="checkbox" @bind="noAmbiguous" /> Exclude look-alikes (Il1O0)</label>
        <button class="btn" @onclick="Generate">Generate</button>
        <CopyButton Text="@output" />
    </div>

    @if (error is not null)
    {
        <div class="alert error">@error</div>
    }
    <textarea class="io" rows="12" readonly>@output</textarea>
</ToolPage>

@code {
    private int length = 20;
    private int count = 5;
    private bool lower = true, upperCase = true, digits = true, symbols = true, noAmbiguous;
    private string output = "";
    private string? error;

    protected override void OnInitialized() => Generate();

    private void Generate()
    {
        error = null;
        var sets = new List<string>();
        if (lower) sets.Add("abcdefghijklmnopqrstuvwxyz");
        if (upperCase) sets.Add("ABCDEFGHIJKLMNOPQRSTUVWXYZ");
        if (digits) sets.Add("0123456789");
        if (symbols) sets.Add("!@#$%^&*()-_=+[]{};:,.?/");
        if (noAmbiguous) sets = sets.Select(s => new string(s.Where(c => !"Il1O0o".Contains(c)).ToArray())).ToList();

        if (sets.Count == 0)
        {
            error = "Select at least one character set.";
            output = "";
            return;
        }

        var len = Math.Clamp(length, Math.Max(4, sets.Count), 128);
        var all = string.Concat(sets);
        output = string.Join('\n', Enumerable.Range(0, Math.Clamp(count, 1, 100)).Select(_ => Create(sets, all, len)));
    }

    private static string Create(List<string> sets, string all, int len)
    {
        var chars = new char[len];
        for (var i = 0; i < sets.Count; i++)
            chars[i] = sets[i][RandomNumberGenerator.GetInt32(sets[i].Length)];
        for (var i = sets.Count; i < len; i++)
            chars[i] = all[RandomNumberGenerator.GetInt32(all.Length)];
        RandomNumberGenerator.Shuffle(chars.AsSpan());
        return new string(chars);
    }
}
